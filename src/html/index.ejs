<!DOCTYPE html>
<html lang="de">
<head>
    <title>Schwimmtraining &amp; Eisbaden – Aqualign | Franziska Partheymüller</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%- include('./partials/_meta', {
        path: '',
        ogTitle: 'Schwimmtraining & Eisbade-Workshops – Aqualign',
        description: 'Schwimmtraining und Eisbade-Workshops mit Franziska Partheymüller – Weltmeisterin im Eisschwimmen und Teamkapitänin der deutschen Nationalmannschaft. Techniktraining, Eisbaden und mentale Stärke.'
    }) %>
    <link rel="icon" type="image/svg+xml" href="public/Logo.svg" sizes="any"/>
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Person",
                    "name": "Franziska Partheymüller",
                    "jobTitle": "Notfallsanitäterin, Heilpraktikerin und Schwimmtrainerin",
                    "description": "Zweifache Weltmeisterin im Eisschwimmen (50 m Brust), Teamkapitänin der deutschen Nationalmannschaft und Notfallsanitäterin mit über 10 Jahren Erfahrung im Schwimmtraining.",
                    "url": "https://aqualign.de/",
                    "award": [
                        "IISA 5th World Championship 2023, Samoëns – Gold, 50 m Brust",
                        "IISA 4th World Championship 2022, Głogów – Gold, 50 m Brust"
                    ]
                },
                {
                    "@type": "WebSite",
                    "name": "Aqualign Swim & Ice",
                    "url": "https://aqualign.de/",
                    "description": "Schwimmtraining und Eisbaden mit Franziska Partheymüller",
                    "inLanguage": "de-DE"
                },
                {
                    "@type": "Service",
                    "name": "Techniktraining Schwimmen",
                    "description": "Individuelles Schwimmtraining mit Fokus auf Technik, Wasserlage und Effizienz. Für Kinder und Erwachsene.",
                    "provider": {
                        "@type": "Person",
                        "name": "Franziska Partheymüller"
                    },
                    "areaServed": "DE",
                    "serviceType": "Schwimmtraining"
                },
                {
                    "@type": "Service",
                    "name": "Workshops Eisschwimmen / Eisbaden",
                    "description": "Workshops für Eisschwimmen und Eisbaden mit Fokus auf Atemkontrolle, mentale Stärke und sichere Kälteanpassung.",
                    "provider": {
                        "@type": "Person",
                        "name": "Franziska Partheymüller"
                    },
                    "areaServed": "DE",
                    "serviceType": "Eisbaden"
                }
            ]
        }
    </script>
</head>
<body>

<a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

<header>
    <div class="header-container">
        <h1>
            <div class="logo">
                <img class="snowflake" src="public/Snowflake-outline.svg" draggable="false" alt="">
                <img class="header-logo" src="public/Logo.svg" draggable="false" alt="Aqualign Logo">
            </div>
            <span>
                <span class="nowrap">Aqualign</span>
                <span class="nowrap">Swim &amp; Ice</span>
            </span>
        </h1>
        <small class="subtitle">
            <span>Präzision im Wasser</span>
            <span class="dash">&ndash;</span>
            <span>Mentale Stärke im Eis</span>
        </small>
    </div>

    <div class="switch">
        <input type="checkbox" id="switch" role="switch" aria-checked="false"
               aria-label="Zwischen Schwimmtraining und Eisbaden wechseln">
        <label for="switch" class="switch-label">
            <div class="label">Schwimm&shy;training</div>
            <div class="slider">
                <div></div>
            </div>
            <div class="label">Eis&shy;baden</div>
        </label>
        <div class="sr-only" aria-live="polite" id="mode-announcement"></div>
    </div>

    <div class="scroll-cue" aria-hidden="true"><span></span><span></span><span></span></div>

    <hr class="gradient"/>

    <%- include('./partials/_nav') %>
</header>

<main id="main">
    <%- include('./partials/schwimmtraining') %>
    <%- include('./partials/eisbaden') %>
</main>

<%- include('./partials/_footer') %>

</body>
</html>
